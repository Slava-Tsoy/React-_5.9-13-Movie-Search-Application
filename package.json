		"@types/react-dom": "^19",
		"eslint": "^10.14.0",
		"eslint-config-next": "16.4.4",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.7",
		"husky": "^9.1.7",
